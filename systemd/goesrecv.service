[Unit]
Description=goesrecv - GOES HRIT receiver/demodulator
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
ExecStart=/usr/bin/stdbuf -oL -eL /usr/local/bin/goesrecv -v -i 10 -c /etc/goestools/goesrecv.conf
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
